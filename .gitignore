# Node.js dependencies (for backend and frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
logs/
*.log
debug.log
yarn-error.log
pm2.log
pm2.pid


# Build output (Vue & Node.js)
dist/
build/
.cache/
public/build/
server/dist/

# Vue-specific files
.vuepress/dist/
.vuepress/cache/
.vuepress/public/
.vite/
.vitepress/cache/
.vitepress/dist/
.idea/
.vscode/

# Coverage reports (for Jest, Cypress, etc.)
coverage/
.nyc_output/

# TypeScript cache
*.tsbuildinfo

# OS-generated files
.DS_Store
Thumbs.db
*.swp

# Docker files (if using Docker)
.dockerignore
docker-compose.override.yml

# Firebase, Amplify, and other cloud services
.firebase/
.amplify/
aws-exports.js

# Jest snapshots
__snapshots__/

# ESLint cache
.eslintcache

# Ignore temporary files
tmp/
temp/

# Cypress test results
cypress/videos/
cypress/screenshots/

# Ignore Storybook builds
.storybook-out/

# Ignore Nuxt.js (if using Nuxt)
.nuxt/
